# Copy to .env and fill in. .env is in .gitignore and in .dockerignore, so it is never committed
# and never ends up in an image layer.
#
# Nothing in this file is a real credential. The values below are placeholders that name the
# environment variable to read a real value from.

# ---------------------------------------------------------------- Gemini
#
# Leave GEMINI_API_KEY empty and set PROJECT_ID instead. That is the production configuration:
# the revision authenticates to Google with the service account it is already running as, so
# there is no long-lived secret anywhere in the system and none to leak or rotate.
#
# Set a key only for local development.
GEMINI_API_KEY=

MODEL_NAME=gemini-2.0-flash
EMBEDDING_MODEL_NAME=text-embedding-004
MAX_TOKENS=2048
TEMPERATURE=0.4
TIMEOUT=60
MAX_INPUT_CHARACTERS=32000

# ---------------------------------------------------------------- Google Cloud
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Which vector store to use: in-memory or vertex. This is explicit rather than inferred from
# whether PROJECT_ID happens to be set, because PROJECT_ID is also what the model calls need and
# inferring from it would turn on a store nobody asked for.
VECTOR_STORE=in-memory

# The Vertex AI Vector Search index. Required when VECTOR_STORE=vertex; the health check reports
# it as a problem when it is missing, and the service falls back to the in-process store so a
# wrong variable does not become an outage.
VECTOR_SEARCH_INDEX_ID=

# Overrides the regional endpoint. Empty means https://<REGION>-aiplatform.googleapis.com.
VECTOR_SEARCH_ENDPOINT=

KNOWLEDGE_COLLECTION=assistant-knowledge

# ---------------------------------------------------------------- security
#
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The service refuses to start in production without a secret of at least 32 characters.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_ISSUER=ai-assistant-cloud

# Turn this off only for a local run against a mock model. /health reports it when it is off.
REQUIRE_AUTHENTICATION=true

# ---------------------------------------------------------------- rate limits
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_VISION_PER_MINUTE=10
RATE_LIMIT_EMBEDDINGS_PER_MINUTE=120
RATE_LIMIT_AGENT_PER_MINUTE=10

# ---------------------------------------------------------------- runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Never true in production. The service refuses to start if it is.
LOG_REQUEST_BODIES=false

MAX_IMAGE_BYTES=5242880

RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARACTERS=30000
RAG_MINIMUM_SIMILARITY=0.3

# The ceiling on how many passages one document may contribute. Removal derives a document's
# passage ids from its title and needs an upper bound on how many there can be.
RAG_MAX_PASSAGES_PER_DOCUMENT=2000
