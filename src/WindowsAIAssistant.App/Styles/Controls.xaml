<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared control styles. Cards stay deliberately light: a system fill, a hairline stroke
        and generous padding instead of shadows or gradients.
    -->

    <Style x:Key="AppSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="AppPagePadding" TargetType="StackPanel">
        <Setter Property="Margin" Value="32,24,32,32" />
        <Setter Property="Spacing" Value="24" />
    </Style>

    <Style x:Key="AppQuickActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource AppQuickActionWidth}" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSectionRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>

    <Style x:Key="AppSettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AppComposerTextBoxStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MaxHeight" Value="140" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
    </Style>

    <Style x:Key="AppEmptyStateIconStyle" TargetType="Border">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>

</ResourceDictionary>
