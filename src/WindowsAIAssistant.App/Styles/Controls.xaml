<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared control styles. Cards stay deliberately light: a system fill, a hairline stroke
        and generous padding instead of shadows or gradients.
    -->

    <Style x:Key="AppSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="AppPagePadding" TargetType="StackPanel">
        <Setter Property="Margin" Value="32,24,32,32" />
        <Setter Property="Spacing" Value="24" />
    </Style>

    <Style x:Key="AppQuickActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource AppQuickActionWidth}" />
        <Setter Property="MinHeight" Value="136" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSectionRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>

    <Style x:Key="AppSettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AppComposerTextBoxStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MaxHeight" Value="140" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
    </Style>

    <Style x:Key="AppEmptyStateIconStyle" TargetType="Border">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>

    <!--
        Transcript rows. The list owns scrolling and nothing is selectable, so the item
        container only has to remove the chrome a selectable row would otherwise draw.
    -->
    <Style x:Key="AppChatTranscriptItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="AppChatBubbleStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="MaxWidth" Value="680" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,10" />
    </Style>
    <Style x:Key="AppEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
    </Style>
    <Style x:Key="AppIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{ThemeResource AppHeroBrush}" />
    </Style>
    <Style TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
</ResourceDictionary>
