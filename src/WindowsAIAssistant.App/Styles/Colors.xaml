<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#235950DE" /><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#7160EF" />
