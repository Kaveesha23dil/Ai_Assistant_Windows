<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Layout and typography tokens. Colors are not redefined here on purpose: the shell
        uses the WinUI system theme brushes directly (CardBackgroundFillColorDefaultBrush,
        TextFillColorPrimaryBrush, CardStrokeColorDefaultBrush, ...) so light and dark themes
        both work without hardcoded values.
    -->

    <!-- Spacing rhythm: 4, 8, 12, 16, 24, 32 -->
    <x:Double x:Key="AppSpaceTiny">4</x:Double>
    <x:Double x:Key="AppSpaceSmall">8</x:Double>
    <x:Double x:Key="AppSpaceMedium">12</x:Double>
    <x:Double x:Key="AppSpaceLarge">16</x:Double>
    <x:Double x:Key="AppSpaceXLarge">24</x:Double>
    <x:Double x:Key="AppSpaceXXLarge">32</x:Double>

    <x:Double x:Key="AppPageTitleFontSize">28</x:Double>
    <x:Double x:Key="AppSectionTitleFontSize">20</x:Double>
    <x:Double x:Key="AppCardCornerRadius">8</x:Double>
    <x:Double x:Key="AppQuickActionWidth">216</x:Double>

</ResourceDictionary>
