<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:WindowsAIAssistant.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
                Style="{StaticResource AppPagePadding}"
                MaxWidth="1120"
                HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="{x:Bind ViewModel.HeaderTitle}" />
                <TextBlock
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.Description}" />
            </StackPanel>

            <Border Style="{StaticResource AppSurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <TextBox
                        MinHeight="40"
                        AutomationProperties.Name="Search local files"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.Name="Search files"
                            Command="{x:Bind ViewModel.SearchCommand}"
                            Content="Search Files"
                            ToolTipService.ToolTip="File search arrives in a later step." />
                        <Button
                            AutomationProperties.Name="Index a folder"
                            Command="{x:Bind ViewModel.IndexFolderCommand}"
                            Content="Index Folder"
                            ToolTipService.ToolTip="Indexing requires the file indexing permission." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppSurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource AppMutedHeadingTextBlockStyle}"
                        Text="Open a document" />
                    <TextBlock
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="Reads one file, summarizes it, and answers questions from what it says. PDF, Word, PowerPoint, Excel, and text files. The file is not uploaded unless you turn on sending documents to a cloud provider." />
                    <TextBox
                        MinHeight="40"
                        AutomationProperties.Name="Path to a document to open"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{x:Bind ViewModel.DocumentPlaceholderText, Mode=OneWay}"
                        Text="{x:Bind ViewModel.DocumentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="Open document"
                            Command="{x:Bind ViewModel.OpenDocumentCommand}"
                            Content="Open Document" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock
                    Style="{StaticResource AppMutedHeadingTextBlockStyle}"
                    Text="Search results" />
                <ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SearchingVisibility, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:FileResultViewModel">
                            <Border Style="{StaticResource AppSurfaceCardStyle}">
                                <Grid ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Style="{StaticResource AppBodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Style="{StaticResource AppCaptionTextBlockStyle}"
                                        Text="{x:Bind LocationText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="2"
                                        Style="{StaticResource AppCaptionTextBlockStyle}">
                                        <Run Text="{x:Bind ExtensionText, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind SizeText, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind ModifiedText, Mode=OneWay}" />
                                    </TextBlock>

                                    <StackPanel
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                        <Button
                                            AutomationProperties.Name="Open file"
                                            Command="{x:Bind OpenCommand}"
                                            Content="Open"
                                            ToolTipService.ToolTip="Open in the app you normally use for this file type." />
                                        <Button
                                            AutomationProperties.Name="Open folder"
                                            Command="{x:Bind OpenFolderCommand}"
                                            Content="Open Folder"
                                            ToolTipService.ToolTip="Open the folder this file is in." />
                                        <Button
                                            AutomationProperties.Name="Summarize document"
                                            Command="{x:Bind SummarizeCommand}"
                                            Content="Summarize"
                                            ToolTipService.ToolTip="Read the file and summarize what it says." />
                                        <Button
                                            AutomationProperties.Name="Ask a question about the document"
                                            Command="{x:Bind AskAiCommand}"
                                            Content="Ask AI"
                                            ToolTipService.ToolTip="Ask the file a question, answered only from what it says." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border
                    Style="{StaticResource AppSurfaceCardStyle}"
                    Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                    <StackPanel
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        Spacing="12">
                        <Border Style="{StaticResource AppEmptyStateIconStyle}">
                            <SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Folder" />
                        </Border>
                        <TextBlock
                            Style="{StaticResource AppEmptyStateTitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.EmptyStateTitle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.EmptyStateMessage}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
