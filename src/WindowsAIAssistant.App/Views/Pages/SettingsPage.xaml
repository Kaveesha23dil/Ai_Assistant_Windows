<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
                Style="{StaticResource AppPagePadding}"
                MaxWidth="1000"
                HorizontalAlignment="Center">

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="Settings" />
                <TextBlock
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.PersistenceNotice}" />
                <StackPanel Spacing="8" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Save settings"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                        Padding="20,8"
                        CornerRadius="{StaticResource AppCardCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SavingVisibility, Mode=OneWay}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="General" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Launch at startup" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LaunchAtStartupNotice}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Launch at startup"
                                IsEnabled="{x:Bind ViewModel.IsLaunchAtStartupSupported}"
                                IsOn="{x:Bind ViewModel.IsLaunchAtStartupEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Show system tray icon" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Keep the assistant available from the notification area." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Show system tray icon"
                                IsOn="{x:Bind ViewModel.IsSystemTrayIconEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="AI" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="AI provider" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ProviderNotice, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="160"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="AI provider"
                                ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.SelectedProviderIndex, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="AI model" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="The model name your provider account can use. It is sent exactly as typed." />
                            </StackPanel>
                            <TextBox
                                Grid.Column="1"
                                MinWidth="200"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="AI model"
                                Text="{x:Bind ViewModel.AiModelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Stream answers" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Show each part of an answer as it arrives. Turn off to wait for the whole answer." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Stream answers"
                                IsOn="{x:Bind ViewModel.IsStreamingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Cloud AI" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Allow requests that leave this device. Nothing is sent while this is off." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Cloud AI"
                                IsOn="{x:Bind ViewModel.IsCloudAiEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Send documents to cloud providers" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Lets the text of a document you open be sent to a cloud provider to summarize it or answer questions about it. Off by default, and also needs Cloud AI above. Local and offline providers ignore both." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Send documents to cloud providers"
                                IsOn="{x:Bind ViewModel.IsDocumentCloudProcessingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Local AI" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Run models on this device. Requires a local provider." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Local AI"
                                IsOn="{x:Bind ViewModel.IsLocalAiEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="Appearance" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <Grid Style="{StaticResource AppSectionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Theme" />
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="System follows your Windows light or dark setting." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Theme"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="Privacy" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.PrivacyNotice}" />
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Clipboard processing" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Clipboard processing"
                                IsOn="{x:Bind ViewModel.IsClipboardProcessingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="File indexing" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="File indexing"
                                IsOn="{x:Bind ViewModel.IsFileIndexingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Screen analysis" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Screen analysis"
                                IsOn="{x:Bind ViewModel.IsScreenAnalysisEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Conversation history" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Conversation history"
                                IsOn="{x:Bind ViewModel.IsConversationHistoryEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Telemetry" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Telemetry"
                                IsOn="{x:Bind ViewModel.IsTelemetryEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="Voice" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.VoiceNotice, Mode=OneWay}" />
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Voice assistant" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Turn spoken commands on and off." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Voice assistant"
                                IsOn="{x:Bind ViewModel.IsVoiceEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Microphone access" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Required before the assistant may open the microphone." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Microphone access"
                                IsOn="{x:Bind ViewModel.IsMicrophoneAccessEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Voice processing" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Allow audio to be processed at all. Turn this off to release the microphone." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Voice processing"
                                IsOn="{x:Bind ViewModel.IsVoiceProcessingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Speak replies aloud" />
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Speak replies aloud"
                                IsOn="{x:Bind ViewModel.IsSpokenResponsesEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Continuous listening" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Keeps the microphone open between commands. Off by default." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Continuous listening"
                                IsOn="{x:Bind ViewModel.IsContinuousListeningEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Confirm sensitive actions" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Holds back actions such as closing a file or changing the volume until you say yes." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Confirm sensitive actions"
                                IsOn="{x:Bind ViewModel.IsConfirmSensitiveActionsEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Cloud speech processing" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Sends audio to a cloud recognizer instead of using the local one." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Cloud speech processing"
                                IsOn="{x:Bind ViewModel.IsCloudSpeechProcessingEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Screen capture" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Allows the assistant to save a screenshot when you ask." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Screen capture"
                                IsOn="{x:Bind ViewModel.IsScreenCaptureEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="System control" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="Allows spoken changes to output volume and mute." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="System control"
                                IsOn="{x:Bind ViewModel.IsSystemControlEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource AppSectionRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                                    Text="Wake word" />
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.WakeWordNotice, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Wake word"
                                IsEnabled="{x:Bind ViewModel.IsWakeWordSupported}"
                                IsOn="{x:Bind ViewModel.IsWakeWordEnabled, Mode=TwoWay}"
                                Style="{StaticResource AppSettingsToggleStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="Notifications" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <Grid Style="{StaticResource AppSectionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource AppCardTitleTextBlockStyle}" Text="Notifications" />
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.NotificationsNotice}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="Notifications"
                            IsEnabled="{x:Bind ViewModel.IsNotificationsSupported}"
                            IsOn="{x:Bind ViewModel.IsNotificationsEnabled, Mode=TwoWay}"
                            Style="{StaticResource AppSettingsToggleStyle}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppMutedHeadingTextBlockStyle}" Text="About" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource AppCardTitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ApplicationName, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.Platform, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
