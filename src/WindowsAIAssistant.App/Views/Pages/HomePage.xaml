<Page x:Class="WindowsAIAssistant.App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:WindowsAIAssistant.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource AppPagePadding}" MaxWidth="1360" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="YOUR PERSONAL WORKSPACE" Style="{StaticResource AppEyebrowStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Greeting}" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.WelcomeMessage}" Style="{StaticResource AppSecondaryTextBlockStyle}" />
            </StackPanel>
                        <Border Style="{StaticResource AppSurfaceCardStyle}" Background="{ThemeResource AppHeroBackgroundBrush}" Padding="0" BorderBrush="{ThemeResource AppAccentBrush}">
                <Grid x:Name="HeroGrid" MinHeight="240" SizeChanged="OnQuickActionsSizeChanged">
                    <Viewbox x:Name="ArtworkVisual" Width="610" HorizontalAlignment="Right" Stretch="Fill" IsHitTestVisible="False" Opacity="{ThemeResource AppArtworkOpacity}">
                        <Canvas Width="610" Height="240">
                            <Path Data="M 0,240 C 180,220 170,180 310,165 C 440,150 370,30 610,0 L 610,50 C 430,80 470,200 330,205 C 180,210 200,240 0,240 Z" Fill="#25416EFF" Opacity="0.9" />
                            <Path Data="M 140,240 C 280,210 260,85 420,95 C 530,100 535,30 610,0 L 610,70 C 520,130 500,150 420,140 C 320,130 350,225 220,240 Z">
                                <Path.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#123E7BFF" /><GradientStop Color="#9B7A64FF" Offset="0.65" /><GradientStop Color="#D8A5A1FF" Offset="1" /></LinearGradientBrush></Path.Fill>
                            </Path>
                            <Path Data="M 220,240 C 420,170 280,15 440,0 C 370,90 520,130 610,180 L 610,240 C 460,160 440,180 340,240 Z">
                                <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#236D80FF" /><GradientStop Color="#AF8D52F5" Offset="0.55" /><GradientStop Color="#164A29BC" Offset="1" /></LinearGradientBrush></Path.Fill>
                            </Path>
                            <Path Data="M 50,240 C 310,210 220,150 405,123 C 510,108 520,20 600,0" Stroke="#8E8FA8FF" StrokeThickness="1" />
                            <Path Data="M 300,240 C 380,130 500,170 610,80" Stroke="#A1CD9FFF" StrokeThickness="2" />
                            <Border Canvas.Left="368" Canvas.Top="80" Width="94" Height="94" CornerRadius="25" Background="#E3181648" BorderBrush="#B6A2FF" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="7" /></Border.RenderTransform>
                                <FontIcon Glyph="&#xE945;" Foreground="#C3A8FF" FontSize="48" />
                            </Border>
                            <Border Canvas.Left="220" Canvas.Top="26" Padding="12,10" CornerRadius="12" Background="#883C47A6" BorderBrush="#6D839FFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-8" /></Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="#DADFFF" /><TextBlock Text="Summarize a document" Foreground="#E5E7FF" FontSize="11" /></StackPanel>
                            </Border>
                            <Border Canvas.Left="170" Canvas.Top="168" Padding="12,10" CornerRadius="12" Background="#88313F9E" BorderBrush="#6D839FFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE721;" FontSize="22" Foreground="#DADFFF" /><TextBlock Text="Find relevant files" Foreground="#E5E7FF" FontSize="11" /></StackPanel>
                            </Border>
                        </Canvas>
                    </Viewbox>
                    <StackPanel x:Name="HeroCopy" Spacing="14" Margin="28" MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="✦  YOUR AI ASSISTANT" Style="{StaticResource AppEyebrowStyle}" />
                        <TextBlock Text="Make room for your next idea." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Ask a question, untangle a document, or get a task moving. Your assistant brings it all together." Style="{StaticResource AppSecondaryTextBlockStyle}" MaxWidth="430" HorizontalAlignment="Left" />
                        <Button Command="{x:Bind ViewModel.AskAiCommand}" Style="{StaticResource AppPrimaryButtonStyle}" AutomationProperties.Name="Start a conversation">
                            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Let's talk" /><FontIcon Glyph="&#xE72A;" FontSize="14" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="4">
                <TextBlock Text="What would you like to do?" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                <TextBlock Text="Your everyday tools, one click away." Style="{StaticResource AppCaptionTextBlockStyle}" />
            </StackPanel>
            <GridView x:Name="QuickActionsGrid" SizeChanged="OnQuickActionsSizeChanged" ItemsSource="{x:Bind ViewModel.QuickActions}" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" HorizontalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="250" ItemHeight="190" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeQuickAction">
                        <Button Command="{x:Bind Command}" Style="{StaticResource AppQuickActionButtonStyle}" Margin="0,0,12,12" VerticalAlignment="Stretch" AutomationProperties.Name="{x:Bind Title}">
                                                        <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AppIconTileStyle}" VerticalAlignment="Center" Background="{ThemeResource AppHeroBackgroundBrush}" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"><FontIcon Glyph="{x:Bind Glyph}" FontSize="23" Foreground="{ThemeResource AppAccentBrush}" /></Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Grid x:Name="DashboardPanels" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid><TextBlock Text="◷  Recent agent activity" FontWeight="SemiBold" /><HyperlinkButton Content="View all" Command="{x:Bind ViewModel.OpenAgentCommand}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="{x:Bind ViewModel.ActivityMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.ActivityEmptyVisibility, Mode=OneWay}" Style="{StaticResource AppSecondaryTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,8"><TextBlock Text="{Binding Goal}" TextWrapping="Wrap" FontSize="13" /><TextBlock Text="{Binding Status}" Style="{StaticResource AppCaptionTextBlockStyle}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="SuggestionsPanel" Grid.Column="1" Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="✧  Suggested for you" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button Command="{x:Bind ViewModel.OpenDocumentsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><Grid><TextBlock Text="Summarize a document" /><FontIcon Glyph="&#xE72A;" FontSize="13" HorizontalAlignment="Right" /></Grid></Button>
                        <Button Command="{x:Bind ViewModel.OpenAgentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><Grid><TextBlock Text="Turn an idea into a plan" /><FontIcon Glyph="&#xE72A;" FontSize="13" HorizontalAlignment="Right" /></Grid></Button>
                        <Button Command="{x:Bind ViewModel.OpenAutomationsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><Grid><TextBlock Text="Create a recurring routine" /><FontIcon Glyph="&#xE72A;" FontSize="13" HorizontalAlignment="Right" /></Grid></Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Expander Header="Voice and workspace preferences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.VoiceStatus, Mode=OneWay}" Style="{StaticResource AppSecondaryTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LiveTranscript, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasLiveTranscript}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Ask by voice" Command="{x:Bind ViewModel.StartListeningCommand}" Visibility="{x:Bind ViewModel.CanStartListening}" />
                        <Button Content="Stop listening" Command="{x:Bind ViewModel.StopListeningCommand}" Visibility="{x:Bind ViewModel.CanStopListening}" />
                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelVoiceCommand}" Visibility="{x:Bind ViewModel.CanCancelVoice}" />
                        <Button Content="Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.VoiceUnavailableMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsVoiceUnavailable}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.PrivacyMode}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
