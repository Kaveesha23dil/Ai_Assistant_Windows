<Page x:Class="WindowsAIAssistant.App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:WindowsAIAssistant.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource AppPagePadding}" MaxWidth="1120" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="YOUR PERSONAL WORKSPACE" Style="{StaticResource AppEyebrowStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Greeting}" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.WelcomeMessage}" Style="{StaticResource AppSecondaryTextBlockStyle}" />
            </StackPanel>
            <Border Style="{StaticResource AppSurfaceCardStyle}" Background="{ThemeResource AppHeroBrush}" Padding="28">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource AppIconTileStyle}" Background="{ThemeResource AppSurfaceBrush}" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="{ThemeResource AppAccentBrush}" />
                    </Border>
                    <TextBlock Text="Make room for your next idea." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Ask a question, untangle a document, or get a task moving. Your assistant brings it all together." Style="{StaticResource AppSecondaryTextBlockStyle}" MaxWidth="620" HorizontalAlignment="Left" />
                    <Button Command="{x:Bind ViewModel.AskAiCommand}" Style="{StaticResource AppPrimaryButtonStyle}" AutomationProperties.Name="Start a conversation">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Let's talk" /><FontIcon Glyph="&#xE72A;" FontSize="14" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Spacing="4">
                <TextBlock Text="What would you like to do?" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                <TextBlock Text="Your everyday tools, one click away." Style="{StaticResource AppCaptionTextBlockStyle}" />
            </StackPanel>
            <GridView x:Name="QuickActionsGrid" SizeChanged="OnQuickActionsSizeChanged" ItemsSource="{x:Bind ViewModel.QuickActions}" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" HorizontalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="250" ItemHeight="190" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeQuickAction">
                        <Button Command="{x:Bind Command}" Style="{StaticResource AppQuickActionButtonStyle}" Margin="0,0,12,12" VerticalAlignment="Stretch" AutomationProperties.Name="{x:Bind Title}">
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource AppIconTileStyle}" HorizontalAlignment="Left"><FontIcon Glyph="{x:Bind Glyph}" FontSize="19" Foreground="{ThemeResource AppAccentBrush}" /></Border>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource AppCardTitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource AppCaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
<Border Style="{StaticResource AppSurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource AppCardTitleTextBlockStyle}"
                            Text="Ask by voice" />
                        <TextBlock
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="Speech is recognized on this device. Nothing is sent to a cloud service." />
                    </StackPanel>

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.IsVoiceEnabled}">
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasLiveTranscript}">
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="Heard so far" />
                            <TextBlock
                                Style="{StaticResource AppBodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.LiveTranscript, Mode=OneWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Voice status"
                                Style="{StaticResource AppSecondaryTextBlockStyle}"
                                Text="{x:Bind ViewModel.VoiceStatus, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                MinWidth="112"
                                AutomationProperties.Name="Cancel voice request"
                                Command="{x:Bind ViewModel.CancelVoiceCommand}"
                                Content="Cancel"
                                ToolTipService.ToolTip="Discard the transcript without acting on it."
                                Visibility="{x:Bind ViewModel.CanCancelVoice}" />

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    MinWidth="112"
                                    AutomationProperties.Name="Stop listening"
                                    Command="{x:Bind ViewModel.StopListeningCommand}"
                                    Content="Stop"
                                    ToolTipService.ToolTip="Finish listening and carry out the command."
                                    Visibility="{x:Bind ViewModel.CanStopListening}" />
                                <Button
                                    MinWidth="112"
                                    AutomationProperties.Name="Ask by voice"
                                    Command="{x:Bind ViewModel.StartListeningCommand}"
                                    Content="Ask by voice"
                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                    ToolTipService.ToolTip="Open the microphone for one command."
                                    Visibility="{x:Bind ViewModel.CanStartListening}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.VoiceUnavailableMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsVoiceUnavailable}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppSurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Your workspace, your preferences" Style="{StaticResource AppCardTitleTextBlockStyle}" />
                    <TextBlock Text="Choose how your assistant uses AI and handles your data." Style="{StaticResource AppSecondaryTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AppMutedSurfaceBrush}" CornerRadius="8" Padding="12,6"><TextBlock Text="{x:Bind ViewModel.AiProvider}" /></Border>
                        <Border Background="{ThemeResource AppMutedSurfaceBrush}" CornerRadius="8" Padding="12,6"><TextBlock Text="{x:Bind ViewModel.PrivacyMode}" /></Border>
                    </StackPanel>
                    <Button Content="Assistant settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
