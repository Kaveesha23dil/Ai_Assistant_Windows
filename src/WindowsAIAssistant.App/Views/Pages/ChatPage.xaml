<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WindowsAIAssistant.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Margin="32,24,32,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="{x:Bind ViewModel.HeaderTitle}" />
                <TextBlock
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="Replies are text only. Nothing the assistant writes is run." />
            </StackPanel>
            <Button
                Grid.Column="1"
                MinWidth="120"
                AutomationProperties.Name="Start a new chat"
                Command="{x:Bind ViewModel.NewChatCommand}"
                Content="New chat"
                ToolTipService.ToolTip="Stop the current answer and clear this conversation." />
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                Padding="32,8,32,16"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Auto"
                AutomationProperties.Name="Conversation"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource AppChatTranscriptItemStyle}"
                ItemsSource="{x:Bind ViewModel.Messages}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                        <!--
                            Three rows rather than one styled row: a transcript is a list of
                            turns with different alignments, and visibility per role is
                            clearer than a style chosen in code behind a template.
                        -->
                        <Grid MaxWidth="720" Margin="0,2">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Spacing="2"
                                Visibility="{x:Bind IsFromUser, Mode=OneWay}">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind RoleLabel, Mode=OneWay}" />
                                <Border
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Style="{StaticResource AppChatBubbleStyle}">
                                    <TextBlock
                                        Style="{StaticResource AppBodyTextBlockStyle}"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Left"
                                Spacing="2"
                                Visibility="{x:Bind IsFromAssistant, Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind RoleLabel, Mode=OneWay}" />
                                <Border
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Style="{StaticResource AppChatBubbleStyle}">
                                    <TextBlock
                                        Style="{StaticResource AppBodyTextBlockStyle}"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Stretch"
                                Spacing="2"
                                Visibility="{x:Bind IsStatus, Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource AppCaptionTextBlockStyle}"
                                    Text="{x:Bind RoleLabel, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--
              The empty state is drawn over the transcript rather than in place of it, so the
              list is still bound while it is shown and does not have to be rebuilt when the
              first message arrives.
            -->
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Border Style="{StaticResource AppEmptyStateIconStyle}">
                    <SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Message" />
                </Border>
                <TextBlock
                    Style="{StaticResource AppEmptyStateTitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyStateTitle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyStateMessage}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="32,12,32,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel MaxWidth="1024" HorizontalAlignment="Stretch" Spacing="8">
                <TextBlock
                    Style="{StaticResource AppCaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentStreamingText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.StreamingVisibility}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AcceptsReturn="True"
                        AutomationProperties.Name="Message to send to the assistant"
                        MaxHeight="120"
                        PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                        Style="{StaticResource AppComposerTextBoxStyle}"
                        Text="{x:Bind ViewModel.DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <TextBox.KeyboardAccelerators>
                            <!--
                                Declared most specific first. The platform prefers the
                                modifier-matched accelerator, so Shift+Insert stays available
                                as a newline while a bare Enter sends.
                            -->
                            <KeyboardAccelerator
                                Invoked="OnShiftEnter"
                                Key="Enter"
                                Modifiers="Shift" />
                            <KeyboardAccelerator Invoked="OnEnter" Key="Enter" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <Button
                        Grid.Column="1"
                        MinWidth="88"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Stop the answer"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Content="Stop"
                        ToolTipService.ToolTip="Stop generating. Text already written is kept."
                        Visibility="{x:Bind ViewModel.StreamingVisibility}" />
                    <Button
                        Grid.Column="2"
                        MinWidth="96"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Cancel voice request"
                        Command="{x:Bind ViewModel.CancelVoiceCommand}"
                        Content="Cancel"
                        ToolTipService.ToolTip="Discard the transcript without acting on it."
                        Visibility="{x:Bind ViewModel.CanCancelVoice}" />
                    <Button
                        Grid.Column="3"
                        MinWidth="96"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Send message"
                        Command="{x:Bind ViewModel.SendCommand}"
                        Content="Send"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource AppCaptionTextBlockStyle}"
                    Text="Enter sends. Shift+Enter starts a new line."
                    TextWrapping="Wrap" />

                <Grid
                    ColumnSpacing="12"
                    Visibility="{x:Bind ViewModel.IsVoiceEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.VoiceStatus, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.LiveTranscript, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasLiveTranscript}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        MinWidth="112"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Ask by voice"
                        Command="{x:Bind ViewModel.StartListeningCommand}"
                        Content="Ask by voice"
                        ToolTipService.ToolTip="Open the microphone for one question."
                        Visibility="{x:Bind ViewModel.CanStartListening}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource AppCaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.VoiceUnavailableMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsVoiceUnavailable}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
