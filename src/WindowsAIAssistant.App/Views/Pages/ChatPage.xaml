<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Margin="32,24,32,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="{x:Bind ViewModel.HeaderTitle}" />
                <TextBlock
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="Conversations arrive in a later step. Nothing is sent yet." />
            </StackPanel>
            <Button
                Grid.Column="1"
                MinWidth="120"
                AutomationProperties.Name="Start a new chat"
                Command="{x:Bind ViewModel.NewChatCommand}"
                Content="New chat"
                ToolTipService.ToolTip="Clears the current draft." />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="32,16,32,16"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Border Style="{StaticResource AppEmptyStateIconStyle}">
                    <SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Message" />
                </Border>
                <TextBlock
                    Style="{StaticResource AppEmptyStateTitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyStateTitle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyStateMessage}"
                    TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="32,12,32,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12" MaxWidth="1024" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="Message to send to the assistant"
                    PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                    Style="{StaticResource AppComposerTextBoxStyle}"
                    Text="{x:Bind ViewModel.DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Send message"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Content="Send"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
