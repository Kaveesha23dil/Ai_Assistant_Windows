<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource AppPagePadding}" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="16">
            <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="Automations and reminders" />
            <TextBlock Text="Run once, daily, or weekly in your current time zone. Keep the app open to run on time; missed occurrences run once when it reopens." TextWrapping="Wrap" />
            <Border Style="{StaticResource AppSurfaceCardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Create a schedule" Style="{StaticResource AppCardTitleTextBlockStyle}" />
                    <TextBox Header="Title" MaxLength="200" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="Action" ItemsSource="{x:Bind ViewModel.ActionChoices}" SelectedIndex="{x:Bind ViewModel.ActionIndex, Mode=TwoWay}" />
                    <TextBox Header="Reminder message or full folder path" MaxLength="4000" Text="{x:Bind ViewModel.Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Reminder text or C:\Users\you\Documents\Reports" />
                    <TextBlock Text="Folder summaries process up to 20 supported files directly in the folder. Document text may be sent to your configured AI provider; enable file search and document-processing permissions in Settings. Results are stored locally." TextWrapping="Wrap" Style="{StaticResource AppCaptionTextBlockStyle}" />
                    <ComboBox Header="Repeat" ItemsSource="{x:Bind ViewModel.RepeatChoices}" SelectedIndex="{x:Bind ViewModel.RepeatIndex, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <DatePicker Header="First date" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
                        <TimePicker Header="Time" Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Content="Create schedule" Command="{x:Bind ViewModel.CreateAutomationCommand}" Style="{StaticResource AppPrimaryButtonStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="Your schedules - select one to view its latest result" Style="{StaticResource AppCardTitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" MaxHeight="380" SelectionMode="Single" AutomationProperties.Name="Saved schedules">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4" Padding="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Kind}" />
                                <TextBlock Text="{Binding Repeat}" />
                                <TextBlock Text="{Binding Status}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Run now" Command="{x:Bind ViewModel.RunNowCommand}" />
                <Button Content="Pause / resume" Command="{x:Bind ViewModel.ToggleEnabledCommand}" />
                <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="Next run" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Selected.NextRunDisplay}" TextWrapping="Wrap" />
            <TextBlock Text="Last run (local time)" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Selected.LastRunDisplay}" />
            <TextBlock Text="Latest result" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Selected.LastResult}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
