<Page
    x:Class="WindowsAIAssistant.App.Views.Pages.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAIAssistant.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
                Style="{StaticResource AppPagePadding}"
                MaxWidth="1120"
                HorizontalAlignment="Center">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource AppPageTitleTextBlockStyle}" Text="{x:Bind ViewModel.HeaderTitle}" />
                <TextBlock
                    Style="{StaticResource AppSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.Description}" />
            </StackPanel>

            <Button
                HorizontalAlignment="Left"
                AutomationProperties.Name="Create a new automation"
                Command="{x:Bind ViewModel.CreateAutomationCommand}"
                Content="Create Automation"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Automation execution arrives in a later step." />

            <StackPanel Spacing="12">
                <TextBlock
                    Style="{StaticResource AppMutedHeadingTextBlockStyle}"
                    Text="Your automations" />
                <Border Style="{StaticResource AppSurfaceCardStyle}">
                    <StackPanel
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        Spacing="12">
                        <Border Style="{StaticResource AppEmptyStateIconStyle}">
                            <SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Play" />
                        </Border>
                        <TextBlock
                            Style="{StaticResource AppEmptyStateTitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.EmptyStateTitle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AppSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.EmptyStateMessage}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Style="{StaticResource AppMutedHeadingTextBlockStyle}"
                    Text="Ideas to start with" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border
                        Width="336"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppCardCornerRadius}">
                        <StackPanel Spacing="8">
                            <SymbolIcon
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Folder" />
                            <TextBlock
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Organize Downloads" />
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="Group downloaded files into folders by type and date." />
                        </StackPanel>
                    </Border>
                    <Border
                        Width="336"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppCardCornerRadius}">
                        <StackPanel Spacing="8">
                            <SymbolIcon
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Message" />
                            <TextBlock
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Create Daily Briefing" />
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="Summarize your calendar and open tasks each morning." />
                        </StackPanel>
                    </Border>
                    <Border
                        Width="336"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppCardCornerRadius}">
                        <StackPanel Spacing="8">
                            <SymbolIcon
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Edit" />
                            <TextBlock
                                Style="{StaticResource AppCardTitleTextBlockStyle}"
                                Text="Rename Documents" />
                            <TextBlock
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="Apply a consistent naming scheme to a folder." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
