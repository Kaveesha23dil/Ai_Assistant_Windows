<Window
    x:Class="WindowsAIAssistant.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAIAssistant.App.ViewModels"
    Title="Windows AI Assistant">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsPaneOpen="{Binding IsNavigationPaneOpen, Mode=TwoWay}"
        IsSettingsVisible="False"
        OpenPaneLength="260"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged">

        <NavigationView.PaneHeader>
            <Grid
                Margin="16,12,16,16"
                ColumnSpacing="12"
                RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8">
                    <SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Symbol="Home" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                    Text="{Binding ApplicationTitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Chat" Tag="Chat">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Files" Tag="Files">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Automations" Tag="Automations">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBarArea"
                Background="Transparent"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="40"
                    Height="32"
                    Margin="12,0,0,0"
                    AutomationProperties.Name="Toggle navigation pane"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaneToggleClick"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Toggle navigation pane">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE700;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                    Text="{Binding SectionTitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
