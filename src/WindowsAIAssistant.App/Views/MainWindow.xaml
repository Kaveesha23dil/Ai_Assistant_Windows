<Window
    x:Class="WindowsAIAssistant.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAIAssistant.App.ViewModels"
    Title="Windows AI Assistant">

    <NavigationView
        x:Name="NavView"
        AutomationProperties.Name="Main navigation"
        BackRequested="OnNavigationBackRequested"
        IsBackButtonVisible="Auto"
        IsBackEnabled="{Binding CanGoBack, Mode=OneWay}"
        IsPaneToggleButtonVisible="False"
        IsPaneOpen="{Binding IsNavigationPaneOpen, Mode=TwoWay}"
        IsSettingsVisible="False"
        OpenPaneLength="260"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged">

        <!--
          Alt+Left is registered here as well as on the navigation view itself. The guard in the
          code-behind makes the two paths safe to have at once: whichever one the toolkit
          chooses to use, only one back step is taken.
        -->
        <NavigationView.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="OnBackAcceleratorInvoked"
                Key="Left"
                Modifiers="Menu" />
        </NavigationView.KeyboardAccelerators>

        <NavigationView.PaneHeader>
            <Grid
                Margin="16,12,16,16"
                ColumnSpacing="12"
                RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8">
                    <SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Symbol="Home" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                    Text="{Binding ApplicationTitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </NavigationView.PaneHeader>

        <!--
          Each item carries a Tag naming its route rather than relying on its visible text, so a
          wording change cannot break routing and a translation can happen without touching code.
          The names match the NavigationRoute values and are read by the shared parser.
        -->
        <NavigationView.MenuItems>
            <NavigationViewItem
                AutomationProperties.Name="Home"
                Content="Home"
                Tag="Home"
                ToolTipService.ToolTip="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Chat"
                Content="Chat"
                Tag="Chat"
                ToolTipService.ToolTip="Chat">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Files"
                Content="Files"
                Tag="Files"
                ToolTipService.ToolTip="Files">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Automations"
                Content="Automations"
                Tag="Automations"
                ToolTipService.ToolTip="Automations">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                AutomationProperties.Name="Assistant settings"
                Content="Settings"
                Tag="Settings"
                ToolTipService.ToolTip="Assistant settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBarArea"
                Background="Transparent"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="40"
                    Height="32"
                    Margin="12,0,0,0"
                    AutomationProperties.Name="Toggle navigation pane"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaneToggleClick"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Toggle navigation pane">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE700;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                    Text="{Binding SectionTitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
