<Window
    x:Class="WindowsAIAssistant.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAIAssistant.App.ViewModels"
    Title="Windows AI Assistant">

    <NavigationView
        x:Name="NavView"
        AutomationProperties.Name="Main navigation"
        BackRequested="OnNavigationBackRequested"
        IsBackButtonVisible="Auto"
        IsBackEnabled="{Binding CanGoBack, Mode=OneWay}"
        IsPaneToggleButtonVisible="False"
        IsPaneOpen="{Binding IsNavigationPaneOpen, Mode=TwoWay}"
        IsSettingsVisible="False"
        OpenPaneLength="240" CompactPaneLength="64" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640"
        PaneDisplayMode="Auto"
        Background="{ThemeResource AppMutedSurfaceBrush}" SelectionChanged="OnNavigationSelectionChanged">

        <!--
          Alt+Left is registered here as well as on the navigation view itself. The guard in the
          code-behind makes the two paths safe to have at once: whichever one the toolkit
          chooses to use, only one back step is taken.
        -->
        <NavigationView.KeyboardAccelerators><KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchFocusInvoked" />
            <KeyboardAccelerator
                Invoked="OnBackAcceleratorInvoked"
                Key="Left"
                Modifiers="Menu" />
        </NavigationView.KeyboardAccelerators>

        <NavigationView.PaneHeader>
            <Grid Margin="12,16,12,24" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AppHeroBackgroundBrush}">
                    <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="{ThemeResource AppAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Windows AI" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="PERSONAL ASSISTANT" FontSize="9" CharacterSpacing="120" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>

        <!--
          Each item carries a Tag naming its route rather than relying on its visible text, so a
          wording change cannot break routing and a translation can happen without touching code.
          The names match the NavigationRoute values and are read by the shared parser.
        -->
        <NavigationView.MenuItems><NavigationViewItemHeader Content="WORKSPACE" />
            <NavigationViewItem
                AutomationProperties.Name="Home"
                Content="Home"
                Tag="Home"
                ToolTipService.ToolTip="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Chat"
                Content="Chat"
                Tag="Chat"
                ToolTipService.ToolTip="Chat">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Files"
                Content="Files"
                Tag="Files"
                ToolTipService.ToolTip="Files">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Document"
                Content="Document"
                Tag="Document"
                ToolTipService.ToolTip="Summarize a document and ask it questions">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Knowledge"
                Content="Knowledge"
                Tag="Knowledge"
                ToolTipService.ToolTip="Search your own documents and ask them questions">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Agent"
                Content="Agent"
                Tag="Agent"
                ToolTipService.ToolTip="Watch a request planned, step by step">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="World" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.Name="Automations"
                Content="Automations"
                Tag="Automations"
                ToolTipService.ToolTip="Automations">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

                <NavigationView.PaneFooter>
            <Border Margin="12,12,12,20" Padding="14" CornerRadius="12" Background="{ThemeResource AppGlassBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.IsNavigationPaneOpen, Mode=OneWay}">
                <StackPanel Spacing="5"><TextBlock Text="Your workspace" FontWeight="SemiBold" /><TextBlock Text="Privacy and AI controls in Settings." Style="{StaticResource AppCaptionTextBlockStyle}" /></StackPanel>
            </Border>
        </NavigationView.PaneFooter>
<NavigationView.FooterMenuItems>
            <NavigationViewItem
                AutomationProperties.Name="Assistant settings"
                Content="Settings"
                Tag="Settings"
                ToolTipService.ToolTip="Assistant settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Border Background="{ThemeResource AppCanvasBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1,1,0,0" CornerRadius="20,0,0,0" Margin="0,8,0,0"><Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBarArea"
                Background="Transparent"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="40"
                    Height="32"
                    Margin="16,0,8,0"
                    AutomationProperties.Name="Toggle navigation pane"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaneToggleClick"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Toggle navigation pane">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE700;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppCardTitleTextBlockStyle}"
                    Text="{Binding SectionTitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Grid.Row="1" Margin="32,8,32,0" MaxWidth="1360" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="WorkspaceSearchBox" AutomationProperties.Name="Search local files" PlaceholderText="Search your files and documents..." Background="{ThemeResource AppGlassBrush}" BorderBrush="{ThemeResource AppStrokeBrush}">
                    <TextBox.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Invoked="OnWorkspaceSearchInvoked" /></TextBox.KeyboardAccelerators>
                </TextBox>
                <Button Grid.Column="1" Content="Search" Click="OnWorkspaceSearchClick" ToolTipService.ToolTip="Search local files (Ctrl+K to focus)" />
            </Grid>
            <InfoBar x:Name="AutomationAlert" Grid.Row="2" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="View schedules" Click="OnViewAutomationsClick" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Frame x:Name="ContentFrame" Grid.Row="3" />
        </Grid>
        </Border>
    </NavigationView>
</Window>
