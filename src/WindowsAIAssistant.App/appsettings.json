{
  "Application": {
    "Name": "Windows AI Assistant",
    "Environment": "Production",
    "EnableDiagnostics": false
  },
  "AI": {
    "Provider": "Mock",
    "Model": "mock-model",
    "Temperature": 0.7,
    "MaxOutputTokens": 2048,
    "RequestTimeoutSeconds": 60,
    "UseStreaming": true,
    "MaxConversationMessages": 20,
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "SystemPrompt": null
  },
  "Features": {
    "EnableAIChat": true,
    "EnableFileSearch": true,
    "EnableClipboard": true,
    "EnableSystemInformation": true,
    "EnableAutomation": false,
    "EnableVoice": false,
    "EnableScreenAI": false,
    "EnableLocalAI": false
  },
  "Privacy": {
    "AllowCloudAI": false,
    "AllowDocumentCloudProcessing": false,
    "AllowTelemetry": false,
    "AllowClipboardProcessing": false,
    "AllowFileIndexing": false,
    "AllowScreenAnalysis": false,
    "StoreConversationHistory": false,
    "AllowMicrophoneAccess": false,
    "AllowVoiceProcessing": false,
    "AllowCloudSpeechProcessing": false,
    "AllowScreenCapture": false,
    "AllowSystemControl": false,
    "AllowApplicationLaunch": true,
    "AllowWebSearch": true,
    "StoreVoiceHistory": false
  },
  "Documents": {
    "Enabled": true,
    "MaximumFileSizeMb": 50,
    "MaximumExtractedCharacters": 1000000,
    "ChunkSizeCharacters": 6000,
    "ChunkOverlapCharacters": 500,
    "MaximumChunksPerRequest": 20,
    "MaximumCombinedSummaries": 20,
    "MaximumCharactersPerRequest": 40000,
    "MaximumConcurrentChunkSummaries": 3,
    "MaximumWorkbookRows": 500,
    "MaximumWorkbookColumns": 50,
    "MaximumWorkbookCells": 20000
  },
  "Voice": {
    "Enabled": false,
    "Language": "en-US",
    "SpeakResponses": true,
    "SpeechVoice": null,
    "SpeechRate": 1.0,
    "SpeechPitch": 1.0,
    "SpeechVolume": 1.0,
    "ContinuousListening": false,
    "WakeWordEnabled": false,
    "WakePhrases": [
      "hey assistant",
      "hey nova"
    ],
    "ConfirmSensitiveActions": true,
    "ConfirmLowConfidenceCommands": true,
    "MinimumCommandConfidence": 0.7,
    "MaximumSpokenResponseLength": 240,
    "SilenceTimeoutMilliseconds": 1200,
    "ReportPartialResults": true,
    "ScreenshotFolder": null
  },
  "UI": {
    "Theme": "System",
    "DefaultPage": "Home",
    "ShowSystemTrayIcon": true,
    "LaunchMinimized": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
