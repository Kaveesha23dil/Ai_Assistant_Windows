<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!--
      Required by the source-generated LibraryImport interop for the GDI screen capture and
      the shell known-folder path lookup. Only the generated marshalling code uses it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="NAudio" />
    <!--
      The only third-party AI SDK in the solution, and it is referenced here on purpose: this
      is the innermost project, so Core, Application, and the interface cannot acquire a
      provider type even by accident. Everything above talks to IAIProvider.
    -->
    <PackageReference Include="OpenAI" />
    <!--
      Document parsing libraries, referenced here for the same reason as the OpenAI SDK: this
      project owns every format-specific detail, so nothing above it can acquire a
      DocumentFormat.OpenXml or PdfPig type by accident and start opening packages itself.
      Both are stable, MIT/Apache-licensed, and entirely managed.
    -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PdfPig" />
    <!--
      The knowledge base is a local SQLite file. Referenced here rather than in Application so
      that no layer above Infrastructure can acquire a connection, a command, or a SQL string:
      everything above it goes through the knowledge repositories, and the one place that knows
      there is a database at all is the one that owns its schema.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsAIAssistant.Core\WindowsAIAssistant.Core.csproj" />
  </ItemGroup>

</Project>
